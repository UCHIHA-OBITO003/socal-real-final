      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square, at least 96\u00d796."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social share image",
        "info": "1200\u00d7630. Used when the site is shared on LinkedIn, Slack, WhatsApp."
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "socal labs"
