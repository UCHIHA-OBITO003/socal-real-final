<section class="section {% if section.settings.background == 'ink' %}section--ink{% elsif section.settings.background == 'white' %}section--white{% else %}section--paper{% endif %}"
         {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
         {{ section.shopify_attributes }}>
  <div class="container">
    <div class="head-split reveal">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="t-h2" style="margin-top:var(--sp-5)">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.subcopy != blank -%}<p>{{ section.settings.subcopy }}</p>{%- endif -%}
    </div>

    <div class="creative-mosaic reveal-stagger">
      {%- for block in section.blocks -%}
        <figure class="creative-mosaic__tile creative-mosaic__tile--{{ block.settings.size | default: 'medium' }}" style="--accent:var(--a-{{ block.settings.accent }});--accent-text:var(--a-{{ block.settings.accent }}-text)" {{ block.shopify_attributes }}>
          {%- if block.settings.asset_file != blank -%}
            <img src="{{ block.settings.asset_file | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="600">
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {%- endif -%}
          <figcaption class="creative-mosaic__cap">
            {%- if block.settings.tag != blank -%}<span class="creative-mosaic__tag">{{ block.settings.tag }}</span>{%- endif -%}
            <span class="creative-mosaic__title">{{ block.settings.title }}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Creative mosaic",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Work in market" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not just a mood board" },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy" },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "select", "id": "background", "label": "Background", "default": "paper",
      "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Dark" } ] }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Mosaic tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Packaging" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "3D render" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_file", "label": "Or theme asset filename" },
        { "type": "select", "id": "size", "label": "Tile size", "default": "medium",
          "options": [
            { "value": "large", "label": "Large (2×2)" },
            { "value": "wide", "label": "Wide (2×1)" },
            { "value": "medium", "label": "Medium (1×1)" },
            { "value": "tall", "label": "Tall (1×2)" }
          ]},
        { "type": "select", "id": "accent", "label": "Accent", "default": "coral",
          "options": [
            { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
            { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
            { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" }
          ]}
      ]
    }
  ],
  "presets": [{ "name": "Creative mosaic" }]
}
{% endschema %}
