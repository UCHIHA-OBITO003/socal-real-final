<section class="section {% if section.settings.background == 'white' %}section--white{% else %}section--paper{% endif %}">
  <div class="container">
    <div class="cta-block reveal" style="--accent:var(--a-{{ section.settings.accent }})">
      <div class="cta-grid">
        <div>
          {%- if section.settings.kicker != blank -%}<span class="kicker" style="color:var(--c-on-ink-2)">{{ section.settings.kicker }}</span>{%- endif -%}
          <h2 class="t-h2" style="margin:var(--sp-5) 0">{{ section.settings.heading }}</h2>
          <p>{{ section.settings.subcopy }}</p>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:flex-end">
          <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="btn btn--on-ink btn--lg">
            {{ section.settings.cta_label }}
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
          </a>
          {%- if settings.booking_url != blank -%}
            <a href="{{ settings.booking_url }}" class="btn btn--ghost-ink btn--lg" rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-calendar"/></svg>
              Book a call
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA band",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Next step" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us what you're building." },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy", "default": "Send the brief, or just the problem. We'll come back with an approach, a timeline and a number." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Discuss Your Project" },
    { "type": "url",  "id": "cta_link",  "label": "CTA link" },
    { "type": "select", "id": "accent", "label": "Glow colour", "default": "blue",
      "options": [
        { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
        { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
        { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" } ] },
    { "type": "select", "id": "background", "label": "Background", "default": "paper",
      "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" } ] }
  ],
  "presets": [{ "name": "CTA band" }]
}
{% endschema %}
