<section class="section {% if section.settings.background == 'ink' %}section--ink{% elsif section.settings.background == 'white' %}section--white{% else %}section--paper{% endif %}"
         {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
         {{ section.shopify_attributes }}>
  <div class="container">
    <div class="head-split reveal">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="t-h2" style="margin-top:var(--sp-5)">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.subcopy != blank -%}<p>{{ section.settings.subcopy }}</p>{%- endif -%}
    </div>

    <div class="device-showcase reveal-stagger">
      {%- for block in section.blocks -%}
        <div class="device-showcase__item" style="--accent:var(--a-{{ block.settings.accent }});--accent-wash:var(--a-{{ block.settings.accent }}-wash);--accent-text:var(--a-{{ block.settings.accent }}-text)" {{ block.shopify_attributes }}>
          <div class="device-showcase__phone">
            <span class="phone-frame">
              <span class="phone-screen">
                {%- assign img_zoom = block.settings.image_zoom | default: 100 -%}
                {%- assign img_pos_x = block.settings.image_pos_x | default: 50 -%}
                {%- assign img_pos_y = block.settings.image_pos_y | default: 0 -%}
                {%- if block.settings.asset_file != blank -%}
                  <img class="phone-screen-fill"
                       src="{{ block.settings.asset_file | asset_url }}"
                       alt="{{ block.settings.title | escape }}"
                       loading="lazy"
                       width="390"
                       height="844"
                       style="--img-zoom: {{ img_zoom }}; --img-pos-x: {{ img_pos_x }}%; --img-pos-y: {{ img_pos_y }}%;">
                {%- elsif block.settings.image != blank -%}
                  <img class="phone-screen-fill"
                       src="{{ block.settings.image | image_url: width: 780 }}"
                       alt="{{ block.settings.title | escape }}"
                       loading="lazy"
                       width="390"
                       height="844"
                       style="--img-zoom: {{ img_zoom }}; --img-pos-x: {{ img_pos_x }}%; --img-pos-y: {{ img_pos_y }}%;">
                {%- endif -%}
                <span class="phone-island" aria-hidden="true"></span>
              </span>
            </span>
          </div>
          <div class="device-showcase__body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.copy }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Device showcase",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Use cases" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apps we ship for" },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy" },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Dark" } ] }
  ],
  "blocks": [
    {
      "type": "device",
      "name": "Device",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Consumer product" },
        { "type": "textarea", "id": "copy", "label": "Copy", "default": "Onboarding, core loop and store presence for a first public release." },
        { "type": "image_picker", "id": "image", "label": "Screen image" },
        { "type": "text", "id": "asset_file", "label": "Or theme asset filename" },
        { "type": "range", "id": "image_zoom", "label": "Image zoom %", "min": 50, "max": 150, "step": 1, "default": 100,
          "info": "Below 100 zooms out; above 100 zooms in." },
        { "type": "range", "id": "image_pos_x", "label": "Image horizontal position %", "min": 0, "max": 100, "step": 1, "default": 50,
          "info": "Lower values shift the crop left." },
        { "type": "range", "id": "image_pos_y", "label": "Image vertical position %", "min": 0, "max": 100, "step": 1, "default": 0,
          "info": "0 = top; 50 = center." },
        { "type": "select", "id": "accent", "label": "Accent", "default": "violet",
          "options": [
            { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
            { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
            { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" }
          ]}
      ]
    }
  ],
  "presets": [{ "name": "Device showcase" }]
}
{% endschema %}
