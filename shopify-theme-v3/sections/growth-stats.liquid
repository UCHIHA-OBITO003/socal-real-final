<section class="section {% if section.settings.background == 'ink' %}section--ink{% elsif section.settings.background == 'white' %}section--white{% else %}section--paper{% endif %}"
         {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
         {{ section.shopify_attributes }}>
  <div class="container">
    <div class="head-split reveal">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="t-h2" style="margin-top:var(--sp-5)">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.subcopy != blank -%}<p>{{ section.settings.subcopy }}</p>{%- endif -%}
    </div>

    <div class="growth-stats reveal-stagger">
      {%- for block in section.blocks -%}
        <div class="growth-stat" style="--accent:var(--a-{{ block.settings.accent }});--accent-wash:var(--a-{{ block.settings.accent }}-wash);--accent-text:var(--a-{{ block.settings.accent }}-text)" {{ block.shopify_attributes }}>
          <div class="growth-stat__head">
            <span class="growth-stat__ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#{{ block.settings.icon }}"/></svg></span>
            {%- if block.settings.value != blank -%}<span class="growth-stat__value">{{ block.settings.value }}</span>{%- endif -%}
          </div>
          <h3 class="growth-stat__label">{{ block.settings.label }}</h3>
          {%- if block.settings.copy != blank -%}<p class="growth-stat__copy">{{ block.settings.copy }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Growth stats",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What we fix first" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Amazon SEO, listings and catalog health" },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "add-ons" },
    { "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Dark" } ] }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "Page 1" },
        { "type": "text", "id": "label", "label": "Label", "default": "Keyword rankings" },
        { "type": "textarea", "id": "copy", "label": "Detail", "default": "Titles, bullets and backend terms rebuilt around real search intent." },
        { "type": "select", "id": "icon", "label": "Icon", "default": "i-search",
          "options": [
            { "value": "i-search", "label": "Search" }, { "value": "i-chart", "label": "Chart" },
            { "value": "i-trend", "label": "Trend" }, { "value": "i-shield", "label": "Shield" },
            { "value": "i-globe", "label": "Globe" }, { "value": "i-cart", "label": "Cart" },
            { "value": "i-megaphone", "label": "Ads" }, { "value": "i-camera", "label": "Creative" }
          ]},
        { "type": "select", "id": "accent", "label": "Accent", "default": "amber",
          "options": [
            { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
            { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
            { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" }
          ]}
      ]
    }
  ],
  "presets": [{ "name": "Growth stats" }]
}
{% endschema %}
