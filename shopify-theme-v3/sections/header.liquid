{%- comment -%}
  Header. Nav is driven by a Shopify menu (linklist) so the client reorders it
  in admin. Dropdown children render in a 2-up mega panel.
{%- endcomment -%}

{% render 'icons' %}

<header class="site-header" data-header {{ section.shopify_attributes }}>
  <div class="container-wide nav-row">
    <a href="{{ routes.root_url }}" class="nav-brand" aria-label="{{ settings.brand_name | default: shop.name }}, home">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 400 | image_tag: widths: '200,400', alt: settings.brand_name | default: shop.name, loading: 'eager' }}
      {%- else -%}
        <span class="nav-mark"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-lab"/></svg></span>
        <span class="nav-name">{{ settings.brand_name | default: shop.name }}<small>{{ settings.brand_tagline }}</small></span>
      {%- endif -%}
    </a>

    {%- assign menu = linklists[section.settings.menu] -%}
    <nav class="nav-menu" aria-label="Main">
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          {%- assign link_title_down = link.title | downcase -%}
          {%- if link_title_down == 'catalog' -%}{%- continue -%}{%- endif -%}
          {%- if link.links.size > 0 -%}
            <div class="nav-item" data-nav-item>
              <button type="button" class="nav-link" aria-expanded="false" data-nav-trigger>
                {{ link.title }}
                <svg class="nav-chevron" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-chevron"/></svg>
              </button>
              <div class="nav-dropdown">
                <div class="dd-grid">
                  {%- for child in link.links -%}
                    {%- assign i = forloop.index0 | modulo: 6 -%}
                    {%- case i -%}
                      {%- when 0 -%}{%- assign a = 'blue' -%}
                      {%- when 1 -%}{%- assign a = 'violet' -%}
                      {%- when 2 -%}{%- assign a = 'teal' -%}
                      {%- when 3 -%}{%- assign a = 'coral' -%}
                      {%- when 4 -%}{%- assign a = 'amber' -%}
                      {%- else -%}{%- assign a = 'sun' -%}
                    {%- endcase -%}
                    <a href="{{ child.url }}" class="dd-link" style="--accent-wash:var(--a-{{ a }}-wash);--accent-text:var(--a-{{ a }}-text)">
                      <span class="dd-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></span>
                      <span><span class="dd-title">{{ child.title }}</span></span>
                    </a>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="nav-link" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Labs v2 fallback until Admin → Navigation menus are wired {%- endcomment -%}
        <div class="nav-item" data-nav-item>
          <button type="button" class="nav-link" aria-expanded="false" data-nav-trigger>
            Services
            <svg class="nav-chevron" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-chevron"/></svg>
          </button>
          <div class="nav-dropdown">
            <div class="dd-grid">
              <a href="/pages/web-apps" class="dd-link" style="--accent-wash:var(--a-blue-wash);--accent-text:var(--a-blue-text)"><span class="dd-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></span><span><span class="dd-title">Web apps</span></span></a>
              <a href="/pages/mobile-apps" class="dd-link" style="--accent-wash:var(--a-violet-wash);--accent-text:var(--a-violet-text)"><span class="dd-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></span><span><span class="dd-title">Mobile apps</span></span></a>
              <a href="/pages/websites" class="dd-link" style="--accent-wash:var(--a-teal-wash);--accent-text:var(--a-teal-text)"><span class="dd-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></span><span><span class="dd-title">Websites &amp; e-commerce</span></span></a>
              <a href="/pages/creative-studio" class="dd-link" style="--accent-wash:var(--a-coral-wash);--accent-text:var(--a-coral-text)"><span class="dd-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></span><span><span class="dd-title">Creative studio</span></span></a>
              <a href="/pages/marketplace-growth" class="dd-link" style="--accent-wash:var(--a-amber-wash);--accent-text:var(--a-amber-text)"><span class="dd-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></span><span><span class="dd-title">Marketplace growth</span></span></a>
              <a href="/pages/paid-media" class="dd-link" style="--accent-wash:var(--a-sun-wash);--accent-text:var(--a-sun-text)"><span class="dd-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></span><span><span class="dd-title">Paid media</span></span></a>
            </div>
          </div>
        </div>
        <a href="/pages/work" class="nav-link">Work</a>
        <a href="/pages/studio" class="nav-link">Studio</a>
        <a href="/pages/contact" class="nav-link">Contact</a>
      {%- endif -%}
    </nav>

    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="btn btn--primary btn--sm nav-cta">
        {{ section.settings.cta_label }}
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
      </a>
    {%- endif -%}

    <button class="nav-burger" type="button" aria-expanded="false" aria-controls="MobileMenu" aria-label="Open menu" data-mobile-toggle>
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-menu"/></svg>
    </button>
  </div>

  <nav class="nav-mobile container" id="MobileMenu" aria-label="Mobile" data-mobile-menu>
    {%- if menu.links.size > 0 -%}
      {%- assign has_services_nav = false -%}
      {%- for link in menu.links -%}
        {%- assign link_title_down = link.title | downcase -%}
        {%- if link.links.size > 0 and link_title_down contains 'service' -%}
          {%- assign has_services_nav = true -%}
        {%- elsif link_title_down == 'services' -%}
          {%- assign has_services_nav = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign services_injected = false -%}
      {%- for link in menu.links -%}
        {%- assign link_title_down = link.title | downcase -%}
        {%- if link_title_down == 'catalog' -%}{%- continue -%}{%- endif -%}
        <a href="{{ link.url }}">{{ link.title }}<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        {%- for child in link.links -%}
          <a href="{{ child.url }}" class="nav-mobile__sub">{{ child.title }}</a>
        {%- endfor -%}
        {%- if has_services_nav == false and services_injected == false and link_title_down == 'home' -%}
          {% render 'mobile-service-links' %}
          {%- assign services_injected = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_services_nav == false and services_injected == false -%}
        {% render 'mobile-service-links' %}
      {%- endif -%}
    {%- else -%}
      <a href="{{ routes.root_url }}">Home<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      {% render 'mobile-service-links' %}
      <a href="/pages/work">Work<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      <a href="/pages/studio">Studio<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      <a href="/pages/contact">Contact<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="btn btn--primary btn--block" style="margin-top:var(--sp-6)">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu",
      "info": "Edit items in Online Store → Navigation. Nested items render as a mega panel." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Let's Build Together" },
    { "type": "url",  "id": "cta_link",  "label": "Button link" }
  ]
}
{% endschema %}
