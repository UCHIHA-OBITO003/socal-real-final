{% comment %}
  Catalog Section - Displays all products in a grid layout matching socal theme style
{% endcomment %}

<section class="section section--paper">
  <div class="container">
    {% if section.settings.kicker != blank or section.settings.heading != blank %}
      <div class="section-head reveal">
        {% if section.settings.kicker != blank %}<span class="kicker">{{ section.settings.kicker }}</span>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="t-h2">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.subcopy != blank %}<p class="t-lead">{{ section.settings.subcopy }}</p>{% endif %}
      </div>
    {% endif %}

    {% comment %} Collection Filter {% endcomment %}
    {% if section.settings.show_filters %}
      <div class="catalog-filters reveal">
        <div class="filter-group">
          <label for="collection-filter" class="filter-label">Filter by Collection:</label>
          <select id="collection-filter" class="filter-select" onchange="filterByCollection(this.value)">
            <option value="all">All Products</option>
            {% for collection in collections %}
              {% if collection.handle != 'frontpage' and collection.products_count > 0 %}
                <option value="{{ collection.handle }}" {% if collection.handle == page.handle %}selected{% endif %}>
                  {{ collection.title }}
                </option>
              {% endif %}
            {% endfor %}
          </select>
        </div>

        <div class="filter-group">
          <label for="sort-filter" class="filter-label">Sort by:</label>
          <select id="sort-filter" class="filter-select" onchange="sortProducts(this.value)">
            <option value="featured">Featured</option>
            <option value="price-ascending">Price: Low to High</option>
            <option value="price-descending">Price: High to Low</option>
            <option value="title-ascending">A-Z</option>
            <option value="title-descending">Z-A</option>
            <option value="created-descending">Newest</option>
            <option value="created-ascending">Oldest</option>
          </select>
        </div>
      </div>
    {% endif %}

    {% comment %} Products Grid {% endcomment %}
    <div class="catalog-grid reveal" id="catalog-grid">
      {% assign current_collection = collections[page.handle] %}
      {% if current_collection and current_collection.products_count > 0 %}
        {% assign products_to_show = current_collection.products %}
      {% else %}
        {% assign products_to_show = collections.all.products %}
      {% endif %}

      {% for product in products_to_show limit: section.settings.products_per_page %}
        <div class="catalog-item" data-collection="{{ product.collections.first.handle }}">
          <div class="catalog-image">
            <a href="{{ product.url }}">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    widths: '300,400,600',
                    alt: product.title,
                    loading: 'lazy',
                    class: 'catalog-img'
                }}
              {% else %}
                <div class="catalog-placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              {% endif %}
            </a>
            {% if product.available == false %}
              <span class="catalog-badge sold-out">Sold Out</span>
            {% endif %}
            {% if product.compare_at_price > product.price %}
              <span class="catalog-badge sale">Sale</span>
            {% endif %}
          </div>

          <div class="catalog-info">
            <h3 class="catalog-title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            
            <div class="catalog-price">
              {% if product.compare_at_price > product.price %}
                <span class="catalog-price-original">{{ product.compare_at_price | money }}</span>
                <span class="catalog-price-sale">{{ product.price | money }}</span>
              {% else %}
                <span class="catalog-price-current">{{ product.price | money }}</span>
              {% endif %}
            </div>

            {% if product.vendor %}
              <div class="catalog-vendor">{{ product.vendor }}</div>
            {% endif %}

            <a href="{{ product.url }}" class="catalog-btn btn btn--primary btn--sm">
              View Product
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
            </a>
          </div>
        </div>
      {% endfor %}

      {% if products_to_show.size == 0 %}
        <div class="catalog-empty">
          <p>No products found in this catalog.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .catalog-filters {
    display: flex;
    gap: var(--sp-6);
    margin-bottom: var(--sp-8);
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .filter-label {
    font-weight: 600;
    font-size: 14px;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-select {
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--color-border);
    border-radius: var(--r-md);
    font-size: 14px;
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    min-width: 200px;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--sp-6);
  }

  .catalog-item {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--r-xl);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    background: var(--color-bg);
  }

  .catalog-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .catalog-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .catalog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .catalog-item:hover .catalog-img {
    transform: scale(1.05);
  }

  .catalog-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .catalog-badge {
    position: absolute;
    top: var(--sp-3);
    right: var(--sp-3);
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-sm);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .catalog-badge.sold-out {
    background: var(--color-error);
    color: white;
  }

  .catalog-badge.sale {
    background: var(--a-coral-text);
    color: white;
  }

  .catalog-info {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .catalog-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
  }

  .catalog-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .catalog-title a:hover {
    color: var(--a-blue-text);
  }

  .catalog-price {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .catalog-price-current {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
  }

  .catalog-price-original {
    font-size: 14px;
    text-decoration: line-through;
    color: var(--color-text-muted);
  }

  .catalog-price-sale {
    font-size: 18px;
    font-weight: 700;
    color: var(--a-coral-text);
  }

  .catalog-vendor {
    font-size: 13px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .catalog-btn {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    justify-content: center;
  }

  .catalog-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--sp-12);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .catalog-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: var(--sp-4);
    }

    .catalog-filters {
      flex-direction: column;
      gap: var(--sp-4);
    }

    .filter-group {
      width: 100%;
    }

    .filter-select {
      flex: 1;
      min-width: auto;
    }
  }
{% endstyle %}

{% javascript %}
  function filterByCollection(collectionHandle) {
    const items = document.querySelectorAll('.catalog-item');
    
    items.forEach(item => {
      if (collectionHandle === 'all' || item.dataset.collection === collectionHandle) {
        item.style.display = 'flex';
      } else {
        item.style.display = 'none';
      }
    });
  }

  function sortProducts(sortBy) {
    const grid = document.getElementById('catalog-grid');
    const items = Array.from(grid.querySelectorAll('.catalog-item'));
    
    items.sort((a, b) => {
      const titleA = a.querySelector('.catalog-title').textContent;
      const titleB = b.querySelector('.catalog-title').textContent;
      const priceA = parseFloat(a.querySelector('.catalog-price-current').textContent.replace(/[^0-9.]/g, ''));
      const priceB = parseFloat(b.querySelector('.catalog-price-current').textContent.replace(/[^0-9.]/g, ''));
      
      switch(sortBy) {
        case 'price-ascending':
          return priceA - priceB;
        case 'price-descending':
          return priceB - priceA;
        case 'title-ascending':
          return titleA.localeCompare(titleB);
        case 'title-descending':
          return titleB.localeCompare(titleA);
        default:
          return 0;
      }
    });
    
    items.forEach(item => grid.appendChild(item));
  }
{% endjavascript %}

{% schema %}
{
  "name": "Catalog",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our catalog"
    },
    {
      "type": "textarea",
      "id": "subcopy",
      "label": "Subcopy"
    },
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
