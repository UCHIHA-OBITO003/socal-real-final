{% comment %}
  Stub for storefront routes this agency site does not use (product, collection,
  cart, blog). Without these templates Shopify errors on /cart, /collections/all
  and /blogs/news, which crawlers will find. See THEME_REVIEW.md B8.
{% endcomment %}
<section class="section center">
  <div class="container">
    <h1 class="t-h1">{{ section.settings.heading }}</h1>
    <p class="t-lead" style="margin:var(--sp-5) auto 0">{{ section.settings.subcopy }}</p>
    <a href="{{ section.settings.cta_link | default: routes.root_url }}" class="btn btn--primary btn--lg mt-8">
      {{ section.settings.cta_label }}
    </a>
  </div>
</section>
{% schema %}
{
  "name": "Not available",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nothing to see here" },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy", "default": "This is an agency site, not a store. Head back to the homepage, or tell us what you were looking for." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Back to home" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ]
}
{% endschema %}
