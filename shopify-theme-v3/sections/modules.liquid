<section class="section {% if section.settings.background == 'ink' %}section--ink{% elsif section.settings.background == 'white' %}section--white{% else %}section--paper{% endif %}"
         {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="container">
    <div class="{% if section.settings.align == 'center' %}section-head section-head--center{% else %}head-split{% endif %} reveal">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="t-h2" style="margin-top:var(--sp-5)">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.subcopy != blank -%}<p>{{ section.settings.subcopy }}</p>{%- endif -%}
    </div>

    <div class="module-grid reveal-stagger">
      {%- for block in section.blocks -%}
        {%- assign a = block.settings.accent -%}
        <div class="module" style="--accent:var(--a-{{ a }});--accent-text:var(--a-{{ a }}-text);--accent-wash:var(--a-{{ a }}-wash)" {{ block.shopify_attributes }}>
          <span class="svc-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#{{ block.settings.icon }}"/></svg></span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.copy }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="{% if section.settings.align == 'center' %}center {% endif %}mt-16">
        <a href="{{ section.settings.cta_link | default: '/pages/contact' }}"
           class="btn {% if section.settings.background == 'ink' %}btn--on-ink{% else %}btn--primary{% endif %} btn--lg">
          {{ section.settings.cta_label }}
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Module grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we build" },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy" },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "select", "id": "align", "label": "Head layout", "default": "split",
      "options": [ { "value": "split", "label": "Split (heading left, copy right)" }, { "value": "center", "label": "Centered" } ] },
    { "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Dark" } ] },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url",  "id": "cta_link",  "label": "CTA link" }
  ],
  "blocks": [
    { "type": "module", "name": "Module", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Discovery & product definition" },
      { "type": "textarea", "id": "copy", "label": "Copy", "default": "Scope, users, flows and the one metric the build has to move." },
      { "type": "select", "id": "icon", "label": "Icon", "default": "i-target",
        "options": [
          { "value": "i-target", "label": "Strategy" }, { "value": "i-code", "label": "Code" },
          { "value": "i-mobile", "label": "Mobile" }, { "value": "i-cart", "label": "E-commerce" },
          { "value": "i-camera", "label": "Creative" }, { "value": "i-cube", "label": "3D" },
          { "value": "i-pen", "label": "Design" }, { "value": "i-megaphone", "label": "Ads" },
          { "value": "i-chart", "label": "Analytics" }, { "value": "i-gear", "label": "Integrations" },
          { "value": "i-globe", "label": "Marketplaces" }, { "value": "i-rocket", "label": "Launch" },
          { "value": "i-shield", "label": "Security" }, { "value": "i-search", "label": "Research" },
          { "value": "i-users", "label": "Team" }, { "value": "i-zap", "label": "Automation" },
          { "value": "i-audit", "label": "Docs" }, { "value": "i-box", "label": "Product" },
          { "value": "i-social", "label": "Social" }, { "value": "i-check", "label": "QA" } ] },
      { "type": "select", "id": "accent", "label": "Accent", "default": "blue",
        "options": [
          { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
          { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
          { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" } ] }
    ]}
  ],
  "presets": [{ "name": "Module grid" }]
}
{% endschema %}
