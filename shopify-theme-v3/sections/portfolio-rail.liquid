{%- comment -%}
  Horizontal portfolio rail (Theme 3).
{%- endcomment -%}

<section class="rail-section" id="{{ section.settings.anchor | default: 'work' }}" {{ section.shopify_attributes }}>
  <div class="container rail-head reveal">
    <h2 class="t-h2" style="letter-spacing:var(--ls-tight)">{{ section.settings.heading | default: 'Selected work.' }}</h2>
    {%- if section.settings.subcopy != blank -%}<p class="rail-sub">{{ section.settings.subcopy }}</p>{%- endif -%}
  </div>
  <div class="container-wide" data-quote-rail>
    <div class="quote-rail portfolio-rail reveal-stagger">
      {%- for block in section.blocks -%}
        {%- assign a = block.settings.accent -%}
        {%- assign href = block.settings.link | default: '#brief' -%}
        <a href="{{ href }}" class="tile tile--{{ block.settings.tone | default: 'light' }}" style="--accent:var(--a-{{ a }});--accent-text:var(--a-{{ a }}-text);--accent-wash:var(--a-{{ a }}-wash)" {% if href contains 'http' %}target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="tile-meta">{{ block.settings.badge }}</span>{%- endif -%}
          <h3 class="tile-title">{{ block.settings.title }}</h3>
          {%- if block.settings.copy != blank -%}<p class="tile-copy">{{ block.settings.copy }}</p>{%- endif -%}
          <span class="tile-media thumb-stack{% if block.settings.image_zoom != blank and block.settings.image_zoom != 100 %} tile-media--zoom{% endif %}"{% if block.settings.image_zoom != blank and block.settings.image_zoom != 100 %} style="--tile-zoom:{{ block.settings.image_zoom }}%"{% endif %}>
            {%- if block.settings.asset_file != blank -%}
              {%- assign tile_src = block.settings.asset_file | asset_url -%}
              <span class="thumb-stack__blur" aria-hidden="true"><img src="{{ tile_src }}" alt="" loading="lazy" width="900" height="675"></span>
              <span class="thumb-stack__veil" aria-hidden="true"></span>
              <span class="thumb-stack__sharp tile-media__sharp">
                <img src="{{ tile_src }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="675">
              </span>
            {%- elsif block.settings.image != blank -%}
              {%- assign tile_src = block.settings.image | image_url: width: 900 -%}
              <span class="thumb-stack__blur" aria-hidden="true"><img src="{{ tile_src }}" alt="" loading="lazy" width="900" height="675"></span>
              <span class="thumb-stack__veil" aria-hidden="true"></span>
              <span class="thumb-stack__sharp tile-media__sharp">
                <img src="{{ tile_src }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="675">
              </span>
            {%- else -%}
              {%- if request.design_mode -%}
              <span class="tile-brief">
                <span class="img-brief-tag"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-camera"/></svg>Image needed</span>
                <span>{{ block.settings.brief | default: 'Add a project shot.' }}</span>
              </span>
              {%- endif -%}
            {%- endif -%}
          </span>
          {%- if href contains 'http://' or href contains 'https://' -%}
            <span class="tile-more">Visit site <i aria-hidden="true">&nearr;</i></span>
          {%- else -%}
            <span class="tile-more">Learn more <i aria-hidden="true">&rsaquo;</i></span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    <div class="quote-nav rail-nav">
      <button type="button" class="prev" aria-label="Previous projects"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></button>
      <button type="button" class="next" aria-label="Next projects"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portfolio rail",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Selected work." },
    { "type": "text", "id": "subcopy", "label": "Subcopy", "default": "Built by us. Grown by us." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "work" }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        { "type": "text", "id": "badge", "label": "Meta badge", "default": "E-commerce · Brand · Growth" },
        { "type": "text", "id": "title", "label": "Title", "default": "HiTork" },
        { "type": "textarea", "id": "copy", "label": "Copy" },
        { "type": "textarea", "id": "brief", "label": "Image brief fallback" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_file", "label": "Or theme asset filename" },
        { "type": "range", "id": "image_zoom", "label": "Image zoom %", "min": 50, "max": 150, "step": 5, "default": 100,
          "info": "Below 100 zooms out (shows more of the image). Above 100 zooms in." },
        { "type": "text", "id": "link", "label": "Link", "default": "#brief" },
        { "type": "select", "id": "tone", "label": "Tile tone", "default": "light",
          "options": [
            { "value": "dark", "label": "Dark" },
            { "value": "light", "label": "Light" },
            { "value": "tint", "label": "Tint" }
          ]},
        { "type": "select", "id": "accent", "label": "Accent", "default": "coral",
          "options": [
            { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
            { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
            { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" }
          ]}
      ]
    }
  ],
  "presets": [{ "name": "Portfolio rail" }]
}
{% endschema %}
