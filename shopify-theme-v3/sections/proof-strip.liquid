{%- comment -%}
  Static product / device proof, visual anchor without Growth Lab KPIs.
{%- endcomment -%}
<section class="section section--ink proof-strip" id="{{ section.settings.anchor | default: 'proof' }}">
  <div class="container">
    <div class="section-head section-head--center reveal">
      {%- if section.settings.kicker != blank -%}<span class="kicker" style="color:var(--c-on-ink-2)">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="t-h2" style="color:#fff">{{ section.settings.heading }}</h2>
      {%- if section.settings.subcopy != blank -%}<p style="color:rgba(255,255,255,.65);max-width:36rem;margin-inline:auto">{{ section.settings.subcopy }}</p>{%- endif -%}
    </div>
    <div class="proof-grid reveal-stagger">
      {%- for block in section.blocks -%}
        {%- assign a = block.settings.accent -%}
        <figure class="proof-card" style="--accent:var(--a-{{ a }});--accent-text:var(--a-{{ a }}-text);--accent-wash:var(--a-{{ a }}-wash)" {{ block.shopify_attributes }}>
          {%- if block.settings.asset_file != blank -%}
            <img src="{{ block.settings.asset_file | asset_url }}" alt="{{ block.settings.label | escape }}" loading="lazy" width="800" height="600">
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.label }}
          {%- else -%}
            <div class="proof-card-empty" aria-hidden="true"></div>
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <figcaption>{{ block.settings.label }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Proof strip",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "In the work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real screens. Real products." },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy", "default": "Apps, storefronts and creative we've shipped on real brands." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "proof" }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "Shot",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Web app" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_file", "label": "Or theme asset filename", "info": "e.g. gdash-devices.png" },
        { "type": "select", "id": "accent", "label": "Accent", "default": "blue",
          "options": [
            { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
            { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
            { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" }
          ]}
      ]
    }
  ],
  "presets": [{ "name": "Proof strip" }]
}
{% endschema %}
