{%- comment -%}
  Equal-weight services. Six peers in a 3-up grid, each with its own accent
  colour. Order carries the emphasis, first card reads first, but no card
  is structurally bigger than another. This is the tech-led arrangement:
  put Web Apps and Mobile Apps first, everything else after.
{%- endcomment -%}

<section class="section section--paper" id="{{ section.settings.anchor | default: 'services' }}">
  <div class="container">
    <div class="head-split reveal">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="t-h2" style="margin-top:var(--sp-5)">{{ section.settings.heading }}</h2>
      </div>
      <p>{{ section.settings.subcopy }}</p>
    </div>

    <div class="svc-grid reveal-stagger">
      {%- for block in section.blocks -%}
        {%- assign a = block.settings.accent -%}
        {%- assign title_down = block.settings.title | downcase -%}
        {%- assign href = block.settings.link | strip -%}
        {%- if href == blank -%}
          {%- if title_down contains 'mobile app' -%}
            {%- assign href = '/pages/mobile-apps' -%}
          {%- elsif title_down contains 'web app' -%}
            {%- assign href = '/pages/web-apps' -%}
          {%- elsif title_down contains 'website' or title_down contains 'e-commerce' or title_down contains 'commerce' -%}
            {%- assign href = '/pages/websites' -%}
          {%- elsif title_down contains 'creative' or title_down contains '3d' -%}
            {%- assign href = '/pages/creative-studio' -%}
          {%- elsif title_down contains 'marketplace' -%}
            {%- assign href = '/pages/marketplace-growth' -%}
          {%- elsif title_down contains 'paid' or title_down contains 'media' or title_down contains 'social' -%}
            {%- assign href = '/pages/paid-media' -%}
          {%- else -%}
            {%- assign href = '#' -%}
          {%- endif -%}
        {%- endif -%}
        <a href="{{ href }}"
           class="svc"
           style="--accent:var(--a-{{ a }});--accent-text:var(--a-{{ a }}-text);--accent-wash:var(--a-{{ a }}-wash)"
           {{ block.shopify_attributes }}>
          <span class="svc-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="svc-go"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></span>
          <span class="svc-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#{{ block.settings.icon }}"/></svg></span>
          <h3 class="t-h3">{{ block.settings.title }}</h3>
          <p>{{ block.settings.copy }}</p>
          {%- if block.settings.tags != blank -%}
            <span class="svc-tags">
              {%- assign tg = block.settings.tags | split: ', ' -%}
              {%- for t in tg -%}<span class="svc-tag">{{ t | strip }}</span>{%- endfor -%}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services grid",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What we do" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One team. The whole build, and the growth after it." },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy",
      "default": "Most brands hire a dev shop, then a marketplace agency, then a creative studio, and spend the next year translating between them. We do all three, which is why the handoffs don't exist." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "services" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Web Applications" },
        { "type": "textarea", "id": "copy", "label": "Copy",
          "default": "Dashboards, portals, internal tools and SaaS products. React and Next.js front ends on APIs we design and maintain." },
        { "type": "text", "id": "tags", "label": "Tags (comma separated)", "default": "React, Next.js, APIs" },
        { "type": "text", "id": "link", "label": "Link", "default": "/pages/web-apps" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "i-code",
          "options": [
            { "value": "i-code", "label": "Web / code" }, { "value": "i-mobile", "label": "Mobile" },
            { "value": "i-cart", "label": "E-commerce" }, { "value": "i-camera", "label": "Creative" },
            { "value": "i-cube", "label": "3D" }, { "value": "i-megaphone", "label": "Ads" },
            { "value": "i-chart", "label": "Analytics" }, { "value": "i-gear", "label": "Integrations" },
            { "value": "i-globe", "label": "Marketplaces" }, { "value": "i-social", "label": "Social" },
            { "value": "i-pen", "label": "Design" }, { "value": "i-zap", "label": "Automation" }
          ]},
        { "type": "select", "id": "accent", "label": "Accent colour", "default": "blue",
          "info": "Give each service its own colour. Don't reuse one twice in the same grid.",
          "options": [
            { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
            { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
            { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" }
          ]}
      ]
    }
  ],
  "presets": [{ "name": "Services grid" }]
}
{% endschema %}
