<section class="section {% if section.settings.background == 'ink' %}section--ink{% elsif section.settings.background == 'white' %}section--white{% else %}section--paper{% endif %}"
         {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
         {{ section.shopify_attributes }}>
  <div class="container">
    <div class="head-split reveal">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="t-h2" style="margin-top:var(--sp-5)">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.subcopy != blank -%}<p>{{ section.settings.subcopy }}</p>{%- endif -%}
    </div>

    <div class="stack-diagram reveal-stagger">
      {%- for block in section.blocks -%}
        <div class="stack-layer" style="--accent:var(--a-{{ block.settings.accent }});--accent-wash:var(--a-{{ block.settings.accent }}-wash);--accent-text:var(--a-{{ block.settings.accent }}-text)" {{ block.shopify_attributes }}>
          <div class="stack-layer__head">
            <span class="stack-layer__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title }}</h3>
          </div>
          {%- if block.settings.tags != blank -%}
            <div class="stack-layer__tags">
              {%- assign tags = block.settings.tags | split: '|' -%}
              {%- for tag in tags -%}
                <span class="stack-tag">{{ tag | strip }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <p class="stack-layer__caption">{{ block.settings.caption }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stack diagram",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Architecture" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How the stack fits together" },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "use-cases" },
    { "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Dark" } ] }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "Layer",
      "settings": [
        { "type": "text", "id": "title", "label": "Layer name", "default": "Frontend" },
        { "type": "text", "id": "tags", "label": "Tech tags (pipe-separated)", "default": "React|Next.js|TypeScript" },
        { "type": "textarea", "id": "caption", "label": "Use case caption", "default": "Dashboards, portals and customer-facing apps." },
        { "type": "select", "id": "accent", "label": "Accent", "default": "blue",
          "options": [
            { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
            { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
            { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" }
          ]}
      ]
    }
  ],
  "presets": [{ "name": "Stack diagram" }]
}
{% endschema %}
