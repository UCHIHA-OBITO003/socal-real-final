{%- comment -%}
  Theme 3 testimonials — horizontal quote rail with prev/next.
{%- endcomment -%}

{%- assign has_quotes = false -%}
{%- if section.blocks.size > 0 -%}{%- assign has_quotes = true -%}{%- endif -%}

{%- if has_quotes or request.design_mode -%}
<section class="section {% if section.settings.background == 'ink' %}section--ink{% elsif section.settings.background == 'white' %}section--white{% else %}section--paper{% endif %}" {{ section.shopify_attributes }}>
  <div class="container" data-quote-rail>
    <div class="head-split reveal">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="t-h2" style="margin-top:var(--sp-5)">{{ section.settings.heading }}</h2>
      </div>
      <div>
        {%- if section.settings.subcopy != blank -%}<p>{{ section.settings.subcopy }}</p>{%- endif -%}
        <div class="quote-nav" style="margin-top:var(--sp-5)">
          <button type="button" class="prev" aria-label="Previous testimonials"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></button>
          <button type="button" class="next" aria-label="Next testimonials"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg></button>
        </div>
      </div>
    </div>

    <div class="quote-rail reveal-stagger">
      {%- if has_quotes -%}
        {%- for block in section.blocks -%}
          {%- assign a = block.settings.accent -%}
          <figure class="quote" style="--accent:var(--a-{{ a }});--accent-text:var(--a-{{ a }}-text);--accent-wash:var(--a-{{ a }}-wash)" {{ block.shopify_attributes }}>
            {%- if block.settings.sample -%}<span class="quote-sample">Sample, replace</span>{%- endif -%}
            <span class="quote-mark" aria-hidden="true">&ldquo;</span>
            <blockquote>{{ block.settings.quote }}</blockquote>
            <figcaption class="quote-by">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 96 | image_tag: class: 'quote-avatar', loading: 'lazy', alt: block.settings.name }}
              {%- else -%}
                <span class="quote-avatar quote-avatar--initial" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
              {%- endif -%}
              <span>
                <b>{{ block.settings.name }}</b>
                <span>{{ block.settings.role }}{% if block.settings.company != blank %} · {{ block.settings.company }}{% endif %}</span>
              </span>
            </figcaption>
          </figure>
        {%- endfor -%}
      {%- else -%}
        {%- assign accents = 'blue, violet, teal' | split: ', ' -%}
        {%- for i in (1..3) -%}
          {%- assign a = accents[forloop.index0] -%}
          <div class="quote quote--empty" style="--accent:var(--a-{{ a }})">
            <p class="quote-empty-copy">Add an attributed quote in Customize.</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials rail",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "In their words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What buyers and guests say about the brands we ship" },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy", "default": "Quotes from public Amazon reviews and guest feedback on Apphia, HiTork and Brown Cows." },
    { "type": "select", "id": "background", "label": "Background", "default": "paper",
      "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Dark" } ] }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "text", "id": "company", "label": "Company" },
        { "type": "image_picker", "id": "avatar", "label": "Photo" },
        { "type": "checkbox", "id": "sample", "label": "Mark as sample", "default": false },
        { "type": "select", "id": "accent", "label": "Accent", "default": "blue",
          "options": [
            { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
            { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
            { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" }
          ]}
      ]
    }
  ],
  "presets": [{ "name": "Testimonials rail" }]
}
{% endschema %}
