<section class="section {% if section.settings.background == 'ink' %}section--ink{% elsif section.settings.background == 'white' %}section--white{% else %}section--paper{% endif %}">
  <div class="container">
    <div class="section-head section-head--center reveal">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="t-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subcopy != blank -%}<p>{{ section.settings.subcopy }}</p>{%- endif -%}
    </div>
    <div class="why-grid reveal-stagger">
      {%- for block in section.blocks -%}
        {%- assign a = block.settings.accent -%}
        <div class="why-card" style="--accent:var(--a-{{ a }});--accent-text:var(--a-{{ a }}-text);--accent-wash:var(--a-{{ a }}-wash)" {{ block.shopify_attributes }}>
          <span class="svc-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#{{ block.settings.icon }}"/></svg></span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.copy }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why us",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why socal labs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why brands keep us on retainer" },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy" },
    { "type": "select", "id": "background", "label": "Background", "default": "ink",
      "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Dark" } ] }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Build and growth under one roof" },
      { "type": "textarea", "id": "copy", "label": "Copy", "default": "The team that ships the app is the team that runs the ads pointed at it." },
      { "type": "select", "id": "icon", "label": "Icon", "default": "i-zap",
        "options": [
          { "value": "i-zap", "label": "Speed" }, { "value": "i-box", "label": "Product" },
          { "value": "i-users", "label": "Team" }, { "value": "i-target", "label": "Focus" },
          { "value": "i-chart", "label": "Data" }, { "value": "i-shield", "label": "Trust" },
          { "value": "i-handshake", "label": "Partnership" }, { "value": "i-code", "label": "Engineering" } ] },
      { "type": "select", "id": "accent", "label": "Accent", "default": "blue",
        "options": [
          { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
          { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
          { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" } ] }
    ]}
  ],
  "presets": [{ "name": "Why us" }]
}
{% endschema %}
