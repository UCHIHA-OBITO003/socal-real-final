{%- comment -%}
  Work showcase, the section that decides whether this reads as a creative
  agency. Layout is asymmetric on purpose: one wide card, then halves, then
  thirds. Every card is an image_picker; drop real project shots in and this
  carries the whole site.

  Empty-state note: a card with no image renders an accent-washed tile with a
  mark, not a grey box. It looks deliberate rather than unfinished, but it is
  still a placeholder, and this section is where real work matters most.
{%- endcomment -%}

<section class="section {% if section.settings.background == 'ink' %}section--ink{% elsif section.settings.background == 'white' %}section--white{% else %}section--paper{% endif %}"
         id="{{ section.settings.anchor | default: 'work' }}">
  <div class="container-wide">
    <div class="head-split reveal">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="t-h2" style="margin-top:var(--sp-5)">{{ section.settings.heading }}</h2>
      </div>
      <p>{{ section.settings.subcopy }}</p>
    </div>

    <div class="work-grid reveal-stagger">
      {%- for block in section.blocks -%}
        {%- assign a = block.settings.accent -%}
        {%- assign span = block.settings.span -%}
        {%- liquid
          assign cls = 'work-card'
          if span == 'wide'
            assign cls = 'work-card work-card--wide'
          elsif span == 'third'
            assign cls = 'work-card work-card--third'
          endif
          assign href = block.settings.link | default: '#'
          assign external = false
          if href contains 'http://' or href contains 'https://'
            assign external = true
          endif
        -%}
        <a href="{{ href }}"
           class="{{ cls }}"
           style="--accent:var(--a-{{ a }});--accent-text:var(--a-{{ a }}-text);--accent-wash:var(--a-{{ a }}-wash)"
           {% if external %}target="_blank" rel="noopener"{% endif %}
           {{ block.shopify_attributes }}>
          <div class="work-media{% if block.settings.image_zoom != blank and block.settings.image_zoom != 100 %} work-media--zoom{% endif %}"{% if block.settings.image_zoom != blank and block.settings.image_zoom != 100 %} style="--tile-zoom:{{ block.settings.image_zoom }}"{% endif %}>
            {%- if block.settings.badge != blank -%}
              <span class="work-badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.asset_file != blank -%}
              <img src="{{ block.settings.asset_file | asset_url }}" alt="{{ block.settings.image_alt | default: block.settings.title | escape }}" loading="lazy" width="1200" height="900">
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image_alt | default: block.settings.title | escape }}" loading="lazy" width="1200" height="900">
            {%- else -%}
              {%- liquid
                assign ratio = '4:3'
                assign minw = 1200
                if span == 'wide'
                  assign ratio = '24:9'
                  assign minw = 1800
                elsif span == 'third'
                  assign minw = 900
                endif
              -%}
              {% render 'image-brief',
                   label: block.settings.title,
                   brief: block.settings.brief,
                   ratio: ratio,
                   min_w: minw %}
            {%- endif -%}
          </div>
          <div class="work-body">
            <div>
              <h3 class="t-h3">{{ block.settings.title }}</h3>
              <span class="work-meta">{{ block.settings.meta }}</span>
            </div>
            <span class="work-open{% if external %} work-open--live{% endif %}">
              {%- if external -%}<span class="work-open-text">Visit site</span>{%- endif -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.all_label != blank and section.settings.all_link != blank -%}
      <div class="center mt-16">
        <a href="{{ section.settings.all_link }}" class="btn btn--outline btn--lg">
          {{ section.settings.all_label }}
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Work showcase",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Selected work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Things we designed, built and shipped." },
    { "type": "textarea", "id": "subcopy", "label": "Subcopy",
      "default": "Apps, storefronts, brand systems and the growth work behind them." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "work" },
    { "type": "select", "id": "background", "label": "Background", "default": "paper",
      "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "ink", "label": "Dark" } ] },
    { "type": "text", "id": "all_label", "label": "View-all label", "default": "See all work" },
    { "type": "url",  "id": "all_link",  "label": "View-all link" }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image",
          "info": "Real project shot. Upload here (not to assets) so Shopify generates responsive sizes. Keep under 250 KB." },
        { "type": "text", "id": "asset_file", "label": "Or theme asset filename",
          "info": "Fallback when Image is empty, e.g. apphia-site-path.png" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "range", "id": "image_zoom", "label": "Image zoom %", "min": 50, "max": 150, "step": 1, "default": 100,
          "info": "Below 100 zooms out (shows more of the image). Above 100 zooms in." },
        { "type": "textarea", "id": "brief", "label": "Image brief",
          "default": "One landscape shot of the finished work, a real screen, render or product photo. No stock, no mockup templates.",
          "info": "Shown inside the empty slot so whoever supplies the photo knows what to send. Disappears once an image is uploaded." },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Mobile app" },
        { "type": "text", "id": "title", "label": "Project", "default": "HiTork" },
        { "type": "text", "id": "meta", "label": "Meta line", "default": "Brand · Amazon · Product creative" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave blank if there's no case study page yet, the card still reads, it just won't promise a page that doesn't exist." },
        { "type": "select", "id": "span", "label": "Card width", "default": "half",
          "options": [
            { "value": "wide", "label": "Full width (21:9)" },
            { "value": "half", "label": "Half width (4:3)" },
            { "value": "third", "label": "Third width (4:3)" }
          ]},
        { "type": "select", "id": "accent", "label": "Accent", "default": "blue",
          "options": [
            { "value": "blue", "label": "Blue" }, { "value": "violet", "label": "Violet" },
            { "value": "teal", "label": "Teal" }, { "value": "coral", "label": "Coral" },
            { "value": "amber", "label": "Amber" }, { "value": "sun", "label": "Sun" }
          ]}
      ]
    }
  ],
  "presets": [{ "name": "Work showcase" }]
}
{% endschema %}
