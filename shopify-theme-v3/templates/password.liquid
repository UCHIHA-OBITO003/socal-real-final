<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ shop.name }}</title>{{ content_for_header }}
{{ 'tokens.css' | asset_url | stylesheet_tag }}{{ 'base.css' | asset_url | stylesheet_tag }}{{ 'components.css' | asset_url | stylesheet_tag }}
</head><body><main class="section center"><div class="container" style="max-width:460px">
<h1 class="t-h1">{{ shop.name }}</h1>
<p class="t-lead" style="margin:var(--sp-5) auto var(--sp-8)">Launching soon.</p>
{% form 'storefront_password' %}
  {{ form.errors | default_errors }}
  <label class="form-label" for="pw">{{ 'general.password_page.login_form_heading' | t }}</label>
  <input class="form-input" type="password" id="pw" name="password" autocomplete="current-password">
  <button class="btn btn--primary btn--block mt-8" type="submit">Enter</button>
{% endform %}
</div></main></body></html>
